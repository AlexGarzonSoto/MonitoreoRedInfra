# ─────────────────────────────────────────────────────────────────────────────
# NetWatch — Variables de entorno
# Copia este archivo como .env y rellena los valores antes de ejecutar
# docker compose up -d
#
# Genera claves JWT con:  openssl rand -hex 64
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=REEMPLAZA_CON_CADENA_ALEATORIA_64_CHARS_openssl_rand_hex_64
JWT_REFRESH_SECRET=REEMPLAZA_CON_OTRA_CADENA_64_CHARS_openssl_rand_hex_64

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=netwatch
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO

# ── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_USER=netwatch
RABBITMQ_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO

# ── Valkey (Redis OSS) ─────────────────────────────────────────────────────
REDIS_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO

# ── SMTP para alertas por email ────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=REEMPLAZA_CON_APP_PASSWORD_GMAIL

# ── Configuración de alertas ───────────────────────────────────────────────
ALERT_MIN_SEVERITY=HIGH
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=admin@netwatch.local
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

# ── Captura de red ─────────────────────────────────────────────────────────
CAPTURE_INTERFACE=eth0
CAPTURE_ENABLED=true

# ── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO

# ── Docker Hub (para CI/CD) ────────────────────────────────────────────────
DOCKERHUB_USERNAME=tu-usuario-dockerhub
