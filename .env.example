# ── JWT (genera con: openssl rand -hex 64) ────────────────────────────────
JWT_SECRET=REEMPLAZA_CON_CADENA_ALEATORIA_DE_64_CHARS_usa_openssl_rand_hex_64
JWT_REFRESH_SECRET=REEMPLAZA_CON_OTRA_CADENA_64_CHARS_usa_openssl_rand_hex_64_diferente

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=netwatch
POSTGRES_USER=netwatch
POSTGRES_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO

# ── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_USER=netwatch
RABBITMQ_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO

# ── Valkey (fork OSS de Redis) ────────────────────────────────────────────
REDIS_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO

# ── SMTP (opcional — alertas por email) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_MIN_SEVERITY=HIGH
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

# ── Captura de red ────────────────────────────────────────────────────────
CAPTURE_INTERFACE=eth0
CAPTURE_ENABLED=true

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=REEMPLAZA_CON_PASSWORD_SEGURO

# ── Docker Hub ────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=tu-usuario-dockerhub
